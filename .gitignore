# ===================================
docker/volumes/
docker/data/
storage/postgres/   # já existente
storage/redis/
*.pid
*.dockerignore

# ===================================
# 6. BANCO DE DADOS LOCAL E MIGRAÇÕES
# ===================================
database/           # mantido do original
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite-journal

# ===================================
# 7. ARQUIVOS ESPECÍFICOS DO PROJETO (conforme sua estrutura)
# ===================================
AGENTS.md           # mantido
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
*~

# ===================================
# 8. IDE E EDITORES
# ===================================
.vscode/
.idea/
*.sublime-*
.project
.classpath

