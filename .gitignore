package-lock.json # se quiser versionar, comente

# ===================================
# 2. BUILD E CACHE (Next.js, React, TypeScript)
# ===================================
dist/
build/
out/
.next/
**/.next/
coverage/
*.tsbuildinfo
.cache/
.parcel-cache/
.eslintcache

# ===================================
